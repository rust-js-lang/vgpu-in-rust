+//! Hygienic JSX component constructors, separate from token parsing.
+use super::parser::{Classes, companion_item, signature};
+use super::template;
+use crate::collections::IndexSet;
+use rustc_ast::{self as ast, ItemKind};
+use rustc_hir::{
+    self as hir,
+    def::{DefKind, Res},
+};
+use rustc_middle::ty::TyCtxt;
+use rustc_session::Session;
+use rustc_span::Span;
+use rustc_span::Symbol;
+use std::collections::{BTreeMap, BTreeSet};
+use std::sync::Mutex;
+
+/// A hygienic props constructor beside a component. Rust resolves its props
+/// type in the definition's module, including aliases and private imports.
+/// Calling it through an imported/renamed component uses Rust's macro
+/// namespace. Its props are built by their type's companion where it has
+/// one, `built` (ADR 0213), else they're a struct literal.
+pub(super) fn component(
+    sess: &Session,
+    item: &ast::Item,
+    built: &IndexSet<String>,
+    classes: &Classes,
+) -> Option<Box<ast::Item>> {
+    let (ident, target, props, handle) = signature(sess, item, classes)?;
+    // A constant's props, or a `thread_local!`'s memo's, are another
+    // component's, wherever it is, whose companion is beside them, imported
+    // with them.
+    let local_companion = built.contains(&props)
+        || (matches!(item.kind, ItemKind::Const(_)) && !props.is_empty())
+        || (matches!(item.kind, ItemKind::Static(_)) && !props.is_empty() && !props.starts_with("::react::"));
+    let imported = if !local_companion && !props.is_empty() && matches!(item.kind, ItemKind::Fn(_)) {
+        imported(sess, ident.span, &props)
+    } else {
+        None
+    };
+    let companion = local_companion || imported.is_some();
+    let builder = imported.as_deref().unwrap_or(&props);
+    let pattern = if props.is_empty() {
+        ""
+    } else {
+        "$($field:ident: $value:expr,)* $(..$base:expr)?"
+    };
+    let value = if props.is_empty() {
+        "()".to_string()
+    } else if companion {
+        format!("{builder}!(@given [$($field: $value,)*] [$($base)?])")
+    } else {
+        format!("{props} {{ $($field: $value,)* $(..$base)? }}")
+    };
+    // A `thread_local!`'s takes props of any lifetime, as its props' companion
+    // says their `'static` form (ADR 0265).
+    let held = matches!(item.kind, ItemKind::Static(_)) && companion && props != "::react::ProviderProps";
+    let function = if held { "static_component" } else { "component" };
+    let call = |target: &str, value: &str| format!("#[rust_js::jsx] ::react::{function}({target}, {value})");
+    let arm = |prefix: &str, body: &str| format!("({prefix} {pattern}) => {{ {body} }}");
+    let mut arms = vec![arm("", &call(&target, &value))];
+    let ref_value = match companion {
+        true => format!("{props}!(@given [r#ref: $reference, $($field: $value,)*] [$($base)?])"),
+        false => format!("{props} {{ r#ref: $reference, $($field: $value,)* $(..$base)? }}"),
+    };
+    if let Some(handle) = handle {
+        let body = format!(
+            "#[rust_js::jsx] ({}).r#ref(::react::checked_ref::<{handle}, _, _>($reference))",
+            call(&target, &value)
+        );
+        arms.push(arm("@ref ($reference:expr)", &body));
+    } else if let ItemKind::Struct(class, ..) = &item.kind {
+        // A class component's `ref` is its instance, which React gives it,
+        // not one of its props (ADR 1041, amended).
+        let body = format!(
+            "#[rust_js::jsx] ::react::class_ref::<{class}, _>({}, $reference)",
+            call(&target, &value)
+        );
+        arms.push(arm("@ref ($reference:expr)", &body));
+    } else if !props.is_empty() {
+        arms.push(arm("@ref ($reference:expr)", &call(&target, &ref_value)));
+    }
+    if props == "::react::ProviderProps" {
+        arms.push(arm("@provider", &call(&format!("::react::provider({target})"), &value)));
+        // Its `Consumer`'s props are its children, a function of its value.
+        let consumed = "::react::ConsumerProps { $($field: $value,)* $(..$base)? }";
+        arms.push(arm(
+            "@consumer",
+            &call(&format!("::react::consumer({target})"), consumed),
+        ));
+    } else if matches!(&item.kind, ItemKind::Fn(f) if !f.generics.params.is_empty()) {
+        let target = format!("{target}::<$($types)*>");
+        arms.push(arm("@types ($($types:tt)*)", &call(&target, &value)));
+        if !props.is_empty() {
+            arms.push(arm(
+                "@types ($($types:tt)*) @ref ($reference:expr)",
+                &call(&target, &ref_value),
+            ));
+        }
+    }
+    let body = format!("{{ {} }}", arms.join(","));
+    // Its expansion writes `#[rust_js::jsx]` on an expression too (ADR 0110).
+    let tokens = template(
+        sess,
+        format!("#[allow_internal_unstable(stmt_expr_attributes)] macro {ident} {body}"),
+        item.span,
+    );
+    companion_item(sess, tokens, "JSX component props", item)
+}
+
+/// Rust name resolution owns which imported type a component takes and whether
+/// its defining module declares our props companion. A discovery session stops
+/// before body checking only when its literal needs replacing by that builder.
+/// The replay carries owned answers, never rustc IDs or interned symbols.
+type SourceKey = (rustc_span::FileName, u32);
+enum Pass {
+    Discover(BTreeSet<SourceKey>),
+    Ready(BTreeMap<SourceKey, bool>),
+    Replay(BTreeMap<SourceKey, bool>),
+    Complete,
+}
+static PASS: Mutex<Pass> = Mutex::new(Pass::Complete);
+
+pub(crate) fn start() {
+    *PASS.lock().expect("JSX props resolution") = Pass::Discover(BTreeSet::new());
+}
+pub(crate) fn replay() -> bool {
+    let mut pass = PASS.lock().expect("JSX props resolution");
+    if matches!(*pass, Pass::Ready(_)) {
+        let Pass::Ready(resolved) = std::mem::replace(&mut *pass, Pass::Complete) else {
+            unreachable!()
+        };
+        *pass = Pass::Replay(resolved);
+        true
+    } else {
+        false
+    }
+}
+fn key(sess: &Session, span: Span) -> SourceKey {
+    let file = sess.source_map().lookup_source_file(span.lo());
+    (file.name.clone(), span.lo().0 - file.start_pos.0)
+}
+fn imported(sess: &Session, span: Span, props: &str) -> Option<String> {
+    let mut pass = PASS.lock().expect("JSX props resolution");
+    let at = key(sess, span);
+    match &mut *pass {
+        Pass::Discover(requests) => {
+            requests.insert(at);
+            None
+        }
+        Pass::Replay(resolved) if resolved.get(&at) == Some(&true) => Some(props.to_string()),
+        Pass::Replay(_) | Pass::Ready(_) | Pass::Complete => None,
+    }
+}
+fn owns_companion(tcx: TyCtxt<'_>, props: rustc_span::def_id::DefId) -> bool {
+    let module = tcx.parent(props);
+    let marker = [Symbol::intern("rust_js"), Symbol::intern("jsx_props")];
+    let owns = |def| {
+        matches!(tcx.def_kind(def), DefKind::Macro(_))
+            && tcx.opt_parent(def) == Some(module)
+            && tcx.item_name(def) == tcx.item_name(props)
+            && tcx.get_attrs_by_path(def, &marker).next().is_some()
+    };
+    if module.is_local() {
+        tcx.hir_crate_items(()).definitions().any(|id| owns(id.to_def_id()))
+    } else {
+        tcx.module_children(module)
+            .iter()
+            .filter_map(|child| child.res.opt_def_id())
+            .any(owns)
+    }
+}
+/// Return true to stop this discovery session before its provisional literals
+/// are checked. With no changed constructor, the original session continues.
+pub(crate) fn resolve(tcx: TyCtxt<'_>) -> bool {
+    let previous = {
+        let mut pass = PASS.lock().expect("JSX props resolution");
+        match &*pass {
+            Pass::Discover(requests) if requests.is_empty() => return false,
+            Pass::Ready(_) | Pass::Complete => return false,
+            _ => std::mem::replace(&mut *pass, Pass::Complete),
+        }
+    };
+    let requests: BTreeSet<_> = match &previous {
+        Pass::Discover(requests) => requests.clone(),
+        Pass::Replay(resolved) => resolved.keys().cloned().collect(),
+        Pass::Ready(_) | Pass::Complete => unreachable!(),
+    };
+    let mut resolved: BTreeMap<_, _> = requests.iter().cloned().map(|key| (key, false)).collect();
+    for id in tcx
+        .hir_crate_items(())
+        .definitions()
+        .filter(|&id| tcx.def_kind(id) == DefKind::Fn)
+    {
+        let Some(span) = tcx.def_ident_span(id) else { continue };
+        let at = key(tcx.sess, span);
+        if !requests.contains(&at) {
+            continue;
+        }
+        let node = tcx.hir_node_by_def_id(id);
+        let Some(decl) = node.fn_decl() else { continue };
+        let Some(input) = decl.inputs.first() else { continue };
+        // A type alias alone imports no macro. Preserve its literal path;
+        // ordinary use/re-export aliases resolve directly to the struct.
+        let hir::TyKind::Path(hir::QPath::Resolved(_, path)) = input.kind else {
+            continue;
+        };
+        let Res::Def(DefKind::Struct, props) = path.res else {
+            continue;
+        };
+        let owned = owns_companion(tcx, props);
+        resolved.insert(at, owned);
+    }
+    match previous {
+        Pass::Discover(_) if resolved.values().any(|&companion| companion) => {
+            *PASS.lock().expect("JSX props resolution") = Pass::Ready(resolved);
+            true
+        }
+        Pass::Replay(expected) if expected != resolved => {
+            tcx.dcx()
+                .err("rust-js: imported JSX props changed during resolution; compile the unchanged sources again");
+            true
+        }
+        Pass::Discover(_) | Pass::Replay(_) => false,
+        Pass::Ready(_) | Pass::Complete => unreachable!(),
+    }
+}
