@@ -0,0 +1,66 @@
+import {beforeAll,expect,test} from 'bun:test';
+import {writeFileSync} from 'node:fs';
+import {join} from 'node:path';
+import {createElement} from 'react';
+import {renderToStaticMarkup} from 'react-dom/server';
+import {buildReact,compiler,fixture,run,target} from './support';
+beforeAll(buildReact,60_000);
+test('ordinary wrappers use imported and renamed flattened props companions',async()=>{
+ const dir=fixture('jsx-imported-props');
+ writeFileSync(join(dir,'lib.rs'),`use react::{JSX,jsx};
+ use react::attributes::AnchorHTMLAttributes;
+ use react::attributes::AnchorHTMLAttributes as RenamedProps;
+ pub fn Wrapped(props: AnchorHTMLAttributes<'_>) -> JSX::Element { jsx! {<a {...props} />} }
+ pub fn Renamed(props: RenamedProps<'_>) -> JSX::Element { jsx! {<a {...props} />} }
+ pub fn Qualified(props: react::attributes::AnchorHTMLAttributes<'_>) -> JSX::Element { jsx! {<a {...props} />} }
+ mod glob { use react::attributes::*; use react::{JSX,jsx}; pub fn Glob(props:AnchorHTMLAttributes<'_>)->JSX::Element {jsx!{<a {...props}/>}} }
+ use glob::Glob;
+ pub fn App()->JSX::Element { jsx! {<><Wrapped href={Some("/one")} className={Some("first")} /><Renamed href={Some("/two")} className={Some("second")} /><Qualified href={Some("/three")} className={Some("third")} /><Glob href={Some("/four")} className={Some("fourth")} /></>} }
+ `);
+ run([compiler,join(dir,'lib.rs'),'-o',join(dir,'lib.js'),'--','--extern',`react=${join(target,'libreact.rmeta')}`,'-L',target]);
+ run([compiler,'--rustc','--edition=2024','--crate-type=lib','--crate-name=wrapped','--target=wasm32-unknown-unknown','--emit=metadata',join(dir,'lib.rs'),'--extern',`react=${join(target,'libreact.rmeta')}`,'-L',target,'-o',join(dir,'libwrapped.rmeta')]);
+ const lib=await import(join(dir,'lib.jsx'));
+ expect(renderToStaticMarkup(createElement(lib.App))).toBe('<a href="/one" class="first"></a><a href="/two" class="second"></a><a href="/three" class="third"></a><a href="/four" class="fourth"></a>');
+});
+
+test('ordinary wrappers preserve literal props without an owned builder',async()=>{
+ const dir=fixture('jsx-imported-props-literals');
+ writeFileSync(join(dir,'lib.rs'),`#![feature(decl_macro)]
+ use react::{JSX,jsx};
+ use std::ops::Range;
+ mod model {
+  pub struct Plain { pub text: &'static str }
+  pub macro Plain { ($($tokens:tt)*) => { compile_error!("unrelated macro called") } }
+ }
