{
  "name": "vgpu-in-rust",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "setup": "bun run patch:compiler && bun install --frozen-lockfile --force && bun install --cwd rust-js --frozen-lockfile --ignore-scripts && bun run assets:prepare",
    "compile": "bun run patch:compiler && bun run assets:prepare && bun rust-js/tooling/cli.js build --package vgpu-prism --package vgpu-web",
    "test:native": "cargo test --locked -p vgpu-prism",
    "test:parity": "bun test tests/parity.test.ts",
    "test:compiled": "bun rust-js/tooling/cli.js test --package vgpu-prism",
    "test": "bun test ./tests/*.test.ts",
    "test:browser": "bunx --bun playwright test",
    "patch:compiler": "bun scripts/patch-rust-js.ts",
    "assets:prepare": "bun scripts/prepare-prism-gpu-benchmarks.mjs"
  },
  "dependencies": {
    "@pmndrs/detect-gpu": "6.0.20",
    "@rust-js/std": "file:rust-js/std",
    "lucide-react": "0.555.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@playwright/test": "1.65.0",
    "vite": "8.3.8",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "@vgpu/wgsl": "0.6.0"
  }
}
