{
  "name": "vgpu-in-rust",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "setup": "bun install --frozen-lockfile --force && bun install --cwd rust-js --frozen-lockfile --ignore-scripts && bun run assets:prepare",
    "compile": "bun run assets:prepare && bun rust-js/tooling/cli.js build --package vgpu-prism --package vgpu-web",
    "test:native": "cargo test --locked -p vgpu-prism",
    "test:parity": "bun test tests/parity.test.ts",
    "test:compiled": "bun rust-js/tooling/cli.js test --package vgpu-prism",
    "test": "bun test ./tests/*.test.ts",
    "test:browser": "bunx --bun playwright test",
    "assets:prepare": "bun scripts/prepare-prism-gpu-benchmarks.mjs && bun scripts/prepare-static-images.ts"
  },
  "dependencies": {
    "@pmndrs/detect-gpu": "6.0.20",
    "@rust-js/std": "file:rust-js/std",
    "@vercel/geistdocs": "1.22.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fumadocs-ui": "16.2.2",
    "lucide-react": "0.555.0",
    "next": "16.3.3",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@vgpu/wgsl": "0.6.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "vite": "8.3.8"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
