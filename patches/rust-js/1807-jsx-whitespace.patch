+
+test("JSX literal children preserve repeated spaces and indentation", async () => {
+  const {dir,args}=compile(`use react::{jsx, JSX};
+pub fn Code() -> JSX::Element {
+    jsx! { <pre>{"  "}<b>{"let"}</b>{"  value  =  1;  "}{"\\tend\\t"}{"\\n  next"}</pre> }
+}
+`);
+  run(args);
+  const {Code}=await import(join(dir,"lib.jsx"));
+  const expected=createElement("pre",null,"  ",createElement("b",null,"let"),"  value  =  1;  ","\tend\t","\n  next");
+  expect(renderToStaticMarkup(Code())).toBe(renderToStaticMarkup(expected));
+});
+
+test("JSX edge spaces preserve one React text child through formatting", async () => {
+ const {dir,args}=compile(`use react::{jsx, JSX};
+pub fn Line() -> JSX::Element {
+ jsx! { <pre><span className="text-red-800 dark:text-[#ff518d]">{"return"}</span>{" 0.55 + 0.45 * "}<span className="text-purple-800 dark:text-[#c472fb]">{"cos"}</span></pre> }
+}
+`);
+ run(args);
+ const {Line}=await import(join(dir,"lib.jsx"));
+ const actual=Line();
+ expect(actual.props.children.map((child:any)=>typeof child==="string"?child:child.type)).toEqual(["span"," 0.55 + 0.45 * ","span"]);
+});
