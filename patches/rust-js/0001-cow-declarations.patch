diff --git a/test/declarations-cow.test.ts b/test/declarations-cow.test.ts
new file mode 100644
index 0000000..c19cb75
--- /dev/null
+++ b/test/declarations-cow.test.ts
@@ -0,0 +1,110 @@
+// Cow's declarations must describe the tagged value the compiler emits (#1748).
+import { expect, test } from "bun:test";
+import { readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { compiler, fixture, root, run } from "./support";
+
+test("Cow return types declare borrowed and owned payloads", async () => {
+  const dir = fixture("declarations-cow");
+  writeFileSync(
+    join(dir, "lib.rs"),
+    `use std::borrow::Cow;
+
+pub fn text(value: &str, owned: bool) -> Cow<'_, str> {
+    if owned { Cow::Owned(value.to_owned()) } else { Cow::Borrowed(value) }
+}
+
+pub fn numbers(value: &[f32; 16], owned: bool) -> Cow<'_, [f32; 16]> {
+    if owned { Cow::Owned(*value) } else { Cow::Borrowed(value) }
+}
+
+pub fn change_owned(value: &[f32; 16]) -> Cow<'_, [f32; 16]> {
+    let mut copy = *value;
+    copy[0] += 1.0;
+    Cow::Owned(copy)
+}
+
+pub fn bytes(value: &[u8]) -> Cow<'_, [u8]> {
+    Cow::Owned(value.to_owned())
+}
+
+pub fn generic<T: Clone>(value: &T) -> Cow<'_, T> {
+    Cow::Borrowed(value)
+}
+`,
+  );
+  run(
+    [
+      compiler,
+      "--declarations",
+      join(dir, "lib.rs"),
+      "-o",
+      join(dir, "lib.js"),
+    ],
+    30_000,
+  );
+  const declarations = readFileSync(join(dir, "lib.d.ts"), "utf8");
+  expect(declarations).not.toMatch(/\bany\b/);
+  expect(declarations).toContain('TAG: "Borrowed"');
+  expect(declarations).toContain('TAG: "Owned"');
+  writeFileSync(
+    join(dir, "use.ts"),
+    `import { text, numbers, bytes, generic } from "./lib.js";
+const words = text("hello", false);
+const word: string = words._0;
+if (words.TAG === "Borrowed") {
+  const borrowed: string = words._0;
+} else {
+  const tag: "Owned" = words.TAG;
+}
+const matrix: number[] = numbers(Array(16).fill(1), true)._0;
+const data: number[] = bytes([1, 2])._0;
+const value: { count: number } = generic({ count: 3 })._0;
+// @ts-expect-error A numeric payload is not a string.
+const wrong: string = numbers(Array(16).fill(1), false)._0;
+// @ts-expect-error Only the two actual enum tags are accepted.
+const impossible: "Other" = words.TAG;
+`,
+  );
+  writeFileSync(
+    join(dir, "tsconfig.json"),
+    JSON.stringify({
+      compilerOptions: {
+        module: "esnext",
+        moduleResolution: "bundler",
+        strict: true,
+        noEmit: true,
+        skipLibCheck: false,
+        typeRoots: [join(root, "node_modules/@types")],
+      },
+      files: ["use.ts"],
+    }),
+  );
+  const checked = Bun.spawnSync(
+    [
+      process.execPath,
+      join(root, "node_modules/typescript/bin/tsc"),
+      "-p",
+      join(dir, "tsconfig.json"),
+    ],
+    { cwd: dir, timeout: 30_000 },
+  );
+  expect(checked.stdout.toString() + checked.stderr.toString()).toBe("");
+  expect(checked.exitCode).toBe(0);
+  const generated = await import(join(dir, "lib.js"));
+  expect(generated.text("hello", false)).toEqual({
+    TAG: "Borrowed",
+    _0: "hello",
+  });
+  expect(generated.text("hello", true)).toEqual({ TAG: "Owned", _0: "hello" });
+  const source = Array.from({ length: 16 }, (_, i) => i);
+  const borrowed = generated.numbers(source, false);
+  const owned = generated.numbers(source, true);
+  expect(borrowed._0).toBe(source);
+  expect(owned._0).toEqual(source);
+  const changed = generated.changeOwned(source);
+  expect(changed._0).not.toBe(source);
+  expect(changed._0[0]).toBe(1);
+  expect(source[0]).toBe(0);
+  expect(generated.bytes([1, 2])).toEqual({ TAG: "Owned", _0: [1, 2] });
+});
