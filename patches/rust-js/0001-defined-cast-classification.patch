diff --git a/test/lowering-defined-casts.test.ts b/test/lowering-defined-casts.test.ts
new file mode 100644
index 0000000..3d5476f
--- /dev/null
+++ b/test/lowering-defined-casts.test.ts
@@ -0,0 +1,138 @@
+import { beforeAll, expect, test } from "bun:test";
+import { readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { runSync } from "./child";
+import { buildReact, compiler, fixture, root, run, target } from "./support";
+beforeAll(buildReact, 600_000);
+const withWeb = [
+  "--",
+  "--edition",
+  "2024",
+  "--extern",
+  `js=${join(target, "libjs.rmeta")}`,
+  "--extern",
+  `webapi=${join(target, "libwebapi.rmeta")}`,
+  "-L",
+  target,
+];
+
+test("a global binding cast to a function pointer is asked without reading or calling it", async () => {
+  const dir = fixture("defined-global-casts");
+  writeFileSync(
+    join(dir, "lib.rs"),
+    `#[cfg_attr(rust_js, rust_js::link_name = "rustJsCastFunction")]
+pub fn optional(input: impl js::IntoUnknown) { unreachable!() }
+#[cfg_attr(rust_js, rust_js::link_name = "rustJsCastNamespace.hook")]
+pub fn namespaced(input: impl js::IntoUnknown) { unreachable!() }
+pub fn guarded() -> bool { js::is_function(namespaced as fn(&'static str)) }
+pub fn direct() -> bool { js::is_defined(optional as fn(&'static str)) }
+pub fn callable() -> bool { js::is_function(optional as fn(&'static str)) }
+pub fn copied() -> bool {
+    let first = optional as fn(&'static str);
+    let second = first;
+    js::is_defined(second)
+}
+pub fn path() -> bool { js::is_defined((optional as fn(&'static str),)) }
+pub fn math() -> bool { js::is_defined(u32::leading_zeros as fn(u32) -> u32) }
+pub fn bitmap() -> bool {
+    js::is_defined(webapi::global::create_image_bitmap as fn(&'static webapi::Blob, Option<webapi::ImageBitmapOptions<'static>>) -> js::Promise<&'static webapi::ImageBitmap>)
+}
+`,
+  );
+  run([compiler, join(dir, "lib.rs"), "-o", join(dir, "lib.js"), ...withWeb]);
+  const text = readFileSync(join(dir, "lib.js"), "utf8");
+  expect(text).toContain('return typeof rustJsCastFunction !== "undefined";');
+  expect(text).toContain('return typeof rustJsCastFunction === "function";');
+  expect(text).toContain('return typeof createImageBitmap !== "undefined";');
+  expect(text).toContain('return typeof Math.clz32 !== "undefined";');
+  const globals = globalThis as Record<string, unknown>;
+  const bitmap = Object.getOwnPropertyDescriptor(
+    globalThis,
+    "createImageBitmap",
+  );
+  delete globals.rustJsCastFunction;
+  delete globals.rustJsCastNamespace;
+  delete globals.createImageBitmap;
+  try {
+    const lib = await import(join(dir, "lib.js"));
+    expect([
+      lib.direct(),
+      lib.callable(),
+      lib.copied(),
+      lib.path(),
+      lib.bitmap(),
+      lib.math(),
+    ]).toEqual([false, false, false, false, false, true]);
+    expect(lib.guarded()).toBe(false);
+    let reads = 0,
+      calls = 0;
+    Object.defineProperty(globalThis, "rustJsCastFunction", {
+      configurable: true,
+      get() {
+        reads++;
+        return () => {
+          calls++;
+        };
+      },
+    });
+    for (const name of ["direct", "callable", "copied", "path"]) {
+      const before = reads;
+      expect(lib[name]()).toBe(true);
+      expect(reads - before).toBe(1);
+    }
+    expect(calls).toBe(0);
+    Object.defineProperty(globalThis, "rustJsCastFunction", {
+      configurable: true,
+      value: 0,
+    });
+    expect([lib.direct(), lib.callable(), lib.copied(), lib.path()]).toEqual([
+      true,
+      false,
+      true,
+      true,
+    ]);
+    globals.createImageBitmap = () => {};
+    expect(lib.bitmap()).toBe(true);
+    globals.rustJsCastNamespace = { hook: () => {} };
+    expect(lib.guarded()).toBe(true);
+  } finally {
+    delete globals.rustJsCastFunction;
+    delete globals.rustJsCastNamespace;
+    delete globals.createImageBitmap;
+    if (bitmap) Object.defineProperty(globalThis, "createImageBitmap", bitmap);
+  }
+});
+
+test("a cast cannot make an ordinary function or an unknown pointer a global binding", () => {
+  const dir = fixture("defined-nonbinding-casts");
+  for (const [name, source] of [
+    [
+      "ordinary",
+      "fn ordinary(_: u32) {} pub fn ask() -> bool { js::is_defined(ordinary as fn(u32)) }",
+    ],
+    ["unknown", "pub fn ask(value: fn(u32)) -> bool { js::is_defined(value) }"],
+    [
+      "ordinary-function",
+      "fn ordinary(_: u32) {} pub fn ask() -> bool { js::is_function(ordinary as fn(u32)) }",
+    ],
+    [
+      "ambiguous",
+      '#[cfg_attr(rust_js, rust_js::link_name = "oneGlobal")] fn first(_: u32) { unreachable!() } #[cfg_attr(rust_js, rust_js::link_name = "anotherGlobal")] fn second(_: u32) { unreachable!() } pub fn ask(flag: bool) -> bool { let pointer: fn(u32); if flag { pointer = first; } else { pointer = second; } js::is_defined(pointer) }',
+    ],
+  ]) {
+    writeFileSync(join(dir, "lib.rs"), source);
+    const result = runSync(
+      [
+        compiler,
+        join(dir, "lib.rs"),
+        "-o",
+        join(dir, name + ".js"),
+        ...withWeb,
+      ],
+      root,
+      30000,
+    );
+    expect(result.code, name).not.toBe(0);
+    expect(result.stderr).toContain("of what isn't a JS global's binding");
+  }
+});
