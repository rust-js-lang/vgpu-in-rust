@@ -0,0 +1,34 @@
+import { beforeAll, expect, test } from 'bun:test';
+import { writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { buildReact, compiler, fixture, run, target } from './support';
+beforeAll(buildReact, 60_000);
+test('Battery Status API retains native promises, getters and listener identity', async()=>{
+ const dir=fixture('webapi-battery');
+ writeFileSync(join(dir,'lib.rs'),`use webapi::{BatteryManager, Event, EventTargetExt, Navigator, events, listener};
+ pub fn supported(navigator: &Navigator) -> bool { js::is_defined((navigator, Navigator::get_battery)) }
+ pub async fn level(navigator: &Navigator) -> f64 { navigator.get_battery().await.level() }
+ pub fn charging(battery: &BatteryManager) -> bool { battery.charging() }
+ pub fn listen(battery: &BatteryManager) -> &'static dyn Fn(&'static Event) {
+   let on_change=listener(|_: &'static Event| {});
+   battery.add_event_listener(events::Levelchange, on_change, None);
+   battery.add_event_listener(events::Chargingchange, on_change, None);
+   on_change
+ }
+ pub fn unlisten(battery: &BatteryManager, handler: &'static dyn Fn(&'static Event)) {
+   battery.remove_event_listener(events::Levelchange,handler,None);
+   battery.remove_event_listener(events::Chargingchange,handler,None);
+ }
+ `);
+ run([compiler,join(dir,'lib.rs'),'-o',join(dir,'lib.js'),'--','--extern',`webapi=${join(target,'libwebapi.rmeta')}`,'--extern',`js=${join(target,'libjs.rmeta')}`,'-L',target]);
+ const lib=await import(join(dir,'lib.js'));
+ const calls:any[]=[];
+ const battery={level:0.25,charging:false,addEventListener:(...args:any[])=>calls.push(['add',...args]),removeEventListener:(...args:any[])=>calls.push(['remove',...args])};
+ const navigator={getBattery:()=>Promise.resolve(battery)};
+ expect(lib.supported({})).toBe(false);expect(lib.supported(navigator)).toBe(true);
+ expect(await lib.level(navigator)).toBe(0.25);expect(lib.charging(battery)).toBe(false);
+ const handler=lib.listen(battery);lib.unlisten(battery,handler);
+ expect(calls.map(c=>c.slice(0,2))).toEqual([['add','levelchange'],['add','chargingchange'],['remove','levelchange'],['remove','chargingchange']]);
+ for(const call of calls) expect(call[2]).toBe(handler);
+ const failure=new Error('denied');await expect(lib.level({getBattery:()=>Promise.reject(failure)})).rejects.toBe(failure);
+});
