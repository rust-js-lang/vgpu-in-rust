+/// One unambiguous initializer, never a guess between control-flow definitions.
+fn assigned_once<'a, 'tcx>(body: &'a mir::Body<'tcx>, local: mir::Local) -> Option<&'a Rvalue<'tcx>> {
+    let mut found =
+        body.basic_blocks
+            .iter()
+            .flat_map(|block| &block.statements)
+            .filter_map(|statement| match &statement.kind {
+                StatementKind::Assign(assign) if assign.0.as_local() == Some(local) => Some(&assign.1),
+                _ => None,
+            });
+    match (found.next(), found.next()) {
+        (Some(value), None) => Some(value),
+        _ => None,
+    }
+}
