+
+test("check:fast partitions the metamorphic sample without dropping or duplicating parts", () => {
+  const file = runs.metamorphic[0].file;
+  for (const cores of [1, 4, 12]) {
+    const scope = { changed: [], branch: [], added: [], cores };
+    for (const options of [
+      { all: true, extra: [] },
+      { all: true, extra: [file] },
+      { all: false, extra: [file] },
+    ]) {
+      const planned = jobs({ ...scope, ...options }).jobs.filter((job) =>
+        job.cmd.includes(file),
+      );
+      expect(planned).toHaveLength(pooledParts(cores));
+      expect(planned.map((job) => job.env.RUST_JS_CASES).sort()).toEqual(
+        Array.from(
+          { length: pooledParts(cores) },
+          (_, i) => `${i + 1}/${pooledParts(cores)}`,
+        ).sort(),
+      );
+      expect(planned.every((job) => job.weight === 1)).toBe(true);
+    }
+  }
+});
