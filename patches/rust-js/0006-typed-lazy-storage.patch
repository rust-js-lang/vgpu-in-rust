diff --git a/test/declarations-lazy.test.ts b/test/declarations-lazy.test.ts
new file mode 100644
index 0000000..d9abff9
--- /dev/null
+++ b/test/declarations-lazy.test.ts
@@ -0,0 +1,52 @@
+
+import {expect,test} from "bun:test";
+import {readFileSync,writeFileSync} from "node:fs";
+import {join} from "node:path";
+import {compiler,fixture,root,run} from "./support";
+
+test("lazy cells and locks declare their initializer and payload states",async()=>{
+  const dir=fixture("declarations-lazy");
+  writeFileSync(join(dir,"lib.rs"),`use std::cell::LazyCell;
+use std::sync::LazyLock;
+
+pub struct Point { pub x: f64, pub y: f64 }
+pub static ORIGIN: LazyLock<Point> = LazyLock::new(|| Point { x: 0.0, y: 0.0 });
+pub fn numbers() -> LazyCell<Vec<u32>> { LazyCell::new(|| vec![1,2,3]) }
+pub fn hold<T>(cell: LazyCell<T>) -> LazyCell<T> { cell }
+pub fn origin() -> &'static Point { &ORIGIN }
+pub fn force_numbers(cell: &LazyCell<Vec<u32>>) -> &Vec<u32> { LazyCell::force(cell) }
+`);
+  run([compiler,"--declarations",join(dir,"lib.rs"),"-o",join(dir,"lib.js")],30_000);
+  const dts=readFileSync(join(dir,"lib.d.ts"),"utf8");
+  expect(dts).not.toMatch(/\bany\b/);
+  writeFileSync(join(dir,"use.ts"),`import {ORIGIN,numbers,hold} from "./lib.js";
+const point: {x:number;y:number}|undefined = ORIGIN.value;
+const initialized: {x:number;y:number}|undefined = ORIGIN.init?.();
+const values: number[]|undefined = numbers().value;
+const value: number|undefined = hold({init:()=>42}).value;
+const ready = hold<number>({value:42});
+const poisoned = hold<number>({init:null});
+// @ts-expect-error The initializer must produce a point.
+const badInit: typeof ORIGIN = {init:()=>123};
+// @ts-expect-error A ready payload must be a point.
+const badPayload: typeof ORIGIN = {value:"x"};
+// @ts-expect-error No initializer and no payload is not a valid lazy state.
+const empty: typeof ORIGIN = {};
+`);
+  writeFileSync(join(dir,"tsconfig.json"),JSON.stringify({compilerOptions:{module:"esnext",moduleResolution:"bundler",strict:true,noEmit:true,skipLibCheck:false,exactOptionalPropertyTypes:true,typeRoots:[join(root,"node_modules/@types")]},files:["use.ts"]}));
+  const checked=Bun.spawnSync([process.execPath,join(root,"node_modules/typescript/bin/tsc"),"-p",join(dir,"tsconfig.json")],{timeout:30_000});
+  expect(checked.stdout.toString()+checked.stderr.toString()).toBe("");
+  expect(checked.exitCode).toBe(0);
+  const generated=await import(join(dir,"lib.js"));
+  expect(typeof generated.ORIGIN.init).toBe("function");
+  const point=generated.origin();
+  expect(point).toEqual({x:0,y:0});
+  expect(generated.ORIGIN.value).toBe(point);
+  expect(generated.ORIGIN.init).toBeUndefined();
+  const cell=generated.numbers();
+  expect(typeof cell.init).toBe("function");
+  const values=generated.forceNumbers(cell);
+  expect(values).toEqual([1,2,3]);
+  expect(cell.value).toBe(values);
+  expect(cell.init).toBeUndefined();
+});
