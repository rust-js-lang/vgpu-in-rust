+/// The initializer's member name, shared by lowering and declarations.
+pub(in crate::lower) const INITIALIZER: &str = "init";
+
+/// The two observable storage states. Pending includes initialization and
+/// poisoning: its initializer is callable or null; a ready cell holds a value.
+pub(in crate::lower) enum StorageState {
+    Pending,
+    Ready,
+}
+
+impl StorageState {
+    pub(in crate::lower) fn requires_initializer(&self) -> bool {
+        matches!(self, Self::Pending)
+    }
+
+    pub(in crate::lower) fn requires_payload(&self) -> bool {
+        matches!(self, Self::Ready)
+    }
+}
+
+pub(in crate::lower) const STORAGE_STATES: [StorageState; 2] = [StorageState::Pending, StorageState::Ready];
