+test("changing only Cargo runner metadata regenerates test imports and selects the new runner", () => {
+  const lib = "#[test]\nfn one() { assert_eq!(1 + 1, 2); }\n";
+  const dir = testCrate("rust-js-runner-metadata-change", { "src/lib.rs": lib });
+  const before = rustJsTest(dir);
+  expect(before.code, before.said).toBe(0);
+  expect(counts("node", before.said)).toEqual({ pass: 1, fail: 0, skip: 0 });
+  const manifest = join(dir, "Cargo.toml");
+  const original = readFileSync(manifest, "utf8");
+  for (const runner of ["bun", "node"]) {
+    writeFileSync(manifest, original + `\n[package.metadata.rust-js.test]\nrunner = "${runner}"\n`);
+    const after = rustJsTest(dir);
+    expect(after.code, after.said).toBe(0);
+    expect(counts(runner, after.said), after.said).toEqual({ pass: 1, fail: 0, skip: 0 });
+    expect(readFileSync(join(dir, "src/lib.rs"), "utf8")).toBe(lib);
+    const units = rustJsUnits(join(dir, "node_modules/.cache/rust-js/test/wasm32-unknown-unknown/debug"));
+    const written = units.filter(unit => basename(unit).startsWith("app-") && existsSync(join(unit, "lib.test.js")));
+    expect(written).toHaveLength(1);
+    expect(readFileSync(join(written[0], "lib.test.js"), "utf8")).toContain(`import { test } from "${modules[runner]}";`);
+  }
