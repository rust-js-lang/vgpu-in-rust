+test("a RangeError keeps its native constructor, options and thrown identity", async () => {
+  const {dts,lib}=await compiled("range-error-constructor", `pub fn make(message: Option<&str>) -> &'static js::RangeError {
+    js::range_error::new(message, None)
+}
+pub fn caused(cause: &js::Unknown) -> &'static js::RangeError {
+    js::range_error::new(Some("outside"), Some(&js::ErrorOptions { cause: Some(cause) }))
+}
+pub fn fail(message: &str) -> ! {
+    js::throw(js::range_error::new(Some(message), None).as_unknown())
+}
+`);
+  expect(dts).toContain("): RangeError;");
+  const missing=lib.make(undefined);
+  expect(missing).toBeInstanceOf(RangeError);
+  expect(Object.hasOwn(missing,"message")).toBe(false);
+  const explicit=lib.make("");
+  expect(Object.hasOwn(explicit,"message")).toBe(true);
+  expect(explicit.message).toBe("");
+  const cause={id:42};
