+import {expect,test} from "bun:test";
+import {mkdirSync,readFileSync,writeFileSync} from "node:fs";
+import {join} from "node:path";
+import {buildCompiler,buildReact,compiler,fixture,root,run,target} from "./support";
+
+test("React hook handles keep their public generic types and runtime identity",async()=>{
+  buildReact();
+  const dir=fixture("declarations-react-handles");
+  writeFileSync(join(dir,"lib.rs"),`use react::{Dispatch,ForwardedRef,RefObject,SetOptimistic,SetStateAction};
+pub struct State {
+    pub setter: &'static Dispatch<SetStateAction<u32>>,
+    pub dispatch: Dispatch<String>,
+    pub optimistic: SetOptimistic<u32>,
+    pub reference: RefObject<Option<u32>>,
+    pub forwarded: ForwardedRef<u32>,
+}
+pub fn keep(state: State) -> State { state }
+`);
+  run([compiler,"--declarations",join(dir,"lib.rs"),"-o",join(dir,"lib.js"),"--","--extern",`react=${join(target,"libreact.rmeta")}`,"-L",target],30_000);
+  const declaration=readFileSync(join(dir,"lib.d.ts"),"utf8");
+  expect(declaration).not.toMatch(/\bany\b/);
+  expect(declaration).toContain("reference: RefObject<");
+  writeFileSync(join(dir,"use.ts"),`import {keep} from "./lib.js";
+import type {Dispatch,ForwardedRef,RefObject,SetStateAction} from "react";
+declare const state: ReturnType<typeof keep>;
+const setter: Dispatch<SetStateAction<number>> = state.setter;
+setter(1);
+state.setter(previous => previous + 1);
+state.dispatch("action");
+state.optimistic(previous => previous + 1);
+const reference: RefObject<number | null | undefined> = state.reference;
+const forwarded: ForwardedRef<number> = state.forwarded;
+// @ts-expect-error Numeric state does not accept text.
+state.setter("wrong");
+// @ts-expect-error Updaters must return the numeric state type.
+state.setter(previous => "wrong");
+// @ts-expect-error Dispatch retains its action type.
+state.dispatch(123);
+// @ts-expect-error Optimistic state retains its state type.
+state.optimistic("wrong");
+// @ts-expect-error A ref retains the type of its current value.
+state.reference.current = "wrong";
+// @ts-expect-error A forwarded callback retains its pointee type.
+const wrong: typeof state.forwarded = (value: string) => {};
+`);
+  writeFileSync(join(dir,"tsconfig.json"),JSON.stringify({compilerOptions:{module:"esnext",moduleResolution:"bundler",strict:true,noEmit:true,skipLibCheck:false,exactOptionalPropertyTypes:true,typeRoots:[join(root,"node_modules/@types")]},files:["use.ts"]}));
+  const checked=Bun.spawnSync([process.execPath,join(root,"node_modules/typescript/bin/tsc"),"-p",join(dir,"tsconfig.json")],{timeout:30_000,stdout:"pipe",stderr:"pipe"});
+  expect(checked.stdout.toString()+checked.stderr.toString()).toBe("");
+  expect(checked.exitCode).toBe(0);
+  const generated=await import(join(dir,"lib.js"));
+  const callback=()=>{};
+  const state={setter:callback,dispatch:callback,optimistic:callback,reference:{current:1},forwarded:callback};
+  expect(generated.keep(state)).toBe(state);
+  expect(generated.keep(state).setter).toBe(callback);
+  expect(generated.keep(state).reference).toBe(state.reference);
+});
+
+test("React 18 refs use the mutable canonical type with the exact payload",()=>{
+  buildCompiler();
+  const dir=fixture("declarations-react18-ref");
+  const metadata=join(dir,"metadata");
+  mkdirSync(metadata,{recursive:true});
+  run(["react/build.sh","-o",join(metadata,"libreact.rmeta"),"--react","18.0"],30_000);
+  writeFileSync(join(dir,"lib.rs"),"use react::RefObject;\npub fn reference(value: RefObject<u32>) -> RefObject<u32> { value }\n");
+  run([compiler,"--declarations",join(dir,"lib.rs"),"-o",join(dir,"lib.js"),"--","--extern",`react=${join(metadata,"libreact.rmeta")}`,"-L",metadata],30_000);
+  const declaration=readFileSync(join(dir,"lib.d.ts"),"utf8");
+  expect(declaration).toContain("MutableRefObject<number>");
+  expect(declaration).not.toMatch(/\bany\b/);
+  writeFileSync(join(dir,"use.ts"),`import {reference} from "./lib.js";
+const ref=reference({current:1});
+ref.current=2;
+const value: number = ref.current;
+// @ts-expect-error The mutable ref retains its numeric payload.
+ref.current="wrong";
+`);
+  // MutableRefObject retains this exact mutable payload shape in React 18
+  // and the installed React types. The alias assertion checks version selection.
+  writeFileSync(join(dir,"tsconfig.json"),JSON.stringify({compilerOptions:{module:"esnext",moduleResolution:"bundler",strict:true,noEmit:true,skipLibCheck:false,typeRoots:[join(root,"node_modules/@types")]},files:["use.ts"]}));
+  const checked=Bun.spawnSync([process.execPath,join(root,"node_modules/typescript/bin/tsc"),"-p",join(dir,"tsconfig.json")],{timeout:30_000,stdout:"pipe",stderr:"pipe"});
+  expect(checked.stdout.toString()+checked.stderr.toString()).toBe("");
+  expect(checked.exitCode).toBe(0);
+});
