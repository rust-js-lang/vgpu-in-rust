+pub struct State {
+    pub setter: &'static Dispatch<SetStateAction<u32>>,
+    pub dispatch: Dispatch<String>,
+    pub optimistic: SetOptimistic<u32>,
+    pub reference: RefObject<Option<u32>>,
+    pub forwarded: ForwardedRef<u32>,
+}
+pub fn keep(state: State) -> State { state }
+`);
+  run([compiler,"--declarations",join(dir,"lib.rs"),"-o",join(dir,"lib.js"),"--","--extern",`react=${join(target,"libreact.rmeta")}`,"-L",target],30_000);
+  const declaration=readFileSync(join(dir,"lib.d.ts"),"utf8");
+  expect(declaration).not.toMatch(/\bany\b/);
+  expect(declaration).toContain("reference: RefObject<");
