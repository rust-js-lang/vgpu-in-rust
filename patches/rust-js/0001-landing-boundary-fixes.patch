index 0000000..cba6561
--- /dev/null
+++ b/src/lower/untagged/conversions.rs
@@ -0,0 +1,127 @@
+//! Conversion bodies and erased variant wrappers are separate: only a proven
+//! wrapper returns its argument without executing a body (#1775).
+use super::untagged_adt;
+use crate::lower::recognition::{Recognition, conversion_target};
+use rustc_hir as hir;
+use rustc_hir::def::{CtorKind, CtorOf, DefKind, Res};
+use rustc_middle::mir::{self, AggregateKind, Operand, Rvalue, StatementKind, TerminatorKind};
+use rustc_middle::ty::{self, GenericArgsRef, TyCtxt};
+use rustc_span::def_id::DefId;
+
+impl<'tcx> Recognition<'_, 'tcx> {
+    /// From and Into share the resolved From implementation's identity proof.
+    /// Any other conversion executes its Rust body through normal trait lowering.
+    pub(in crate::lower) fn untagged_conversion_is_identity(&self, id: DefId, args: GenericArgsRef<'tcx>) -> bool {
+        let tcx = self.tcx;
+        if !conversion_target(tcx, id, args).is_some_and(|target| untagged_adt(tcx, target).is_some()) {
+            return false;
+        }
+        let Some(from) = self.from_impl_for_conversion(id, args) else {
+            return false;
+        };
+        is_untagged_from(tcx, from)
+    }
+}
+
+/// The one identity answer shared by call lowering and borrow/effect analysis.
+/// A local body's exact wrapper is read from HIR. A foreign wrapper must have
+/// available MIR proving the same; an unavailable or effectful body isn't assumed.
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub(crate) enum FromBody {
+    Identity,
+    Rust,
+}
+
+pub(crate) fn is_untagged_from(tcx: TyCtxt<'_>, id: DefId) -> bool {
+    from_body(tcx, id) == Some(FromBody::Identity)
+}
+
+pub(crate) fn from_body(tcx: TyCtxt<'_>, id: DefId) -> Option<FromBody> {
+    if tcx.def_kind(id) != DefKind::AssocFn || tcx.trait_impl_of_assoc(id).is_none() {
+        return None;
+    }
+    let target = conversion_target(tcx, id, ty::GenericArgs::identity_for_item(tcx, id))?;
+    let (adt, _) = untagged_adt(tcx, target)?;
+    if crate::lower::bindings::is_binding(tcx, id)
+        && matches!(
+            crate::lower::bindings::js_form(tcx, id),
+            crate::lower::bindings::JsForm::This
+        )
+    {
+        return Some(FromBody::Identity);
+    }
+    let Some(local) = id.as_local() else {
+        return Some(if foreign_wrapper(tcx, id, adt.did()) {
+            FromBody::Identity
+        } else {
+            FromBody::Rust
+        });
+    };
+    let body = tcx.hir_body_owned_by(local);
+    let Some(param) = body.params.first() else {
+        return Some(FromBody::Rust);
+    };
+    let mut value = body.value;
+    while let hir::ExprKind::Block(block, _) = value.kind
+        && block.stmts.is_empty()
+        && let Some(inner) = block.expr
+    {
+        value = inner;
+    }
+    let typeck = tcx.typeck(local);
+    let identity = match value.kind {
+        hir::ExprKind::Call(callee, [arg]) => {
+            let ctor = match callee.kind {
+                hir::ExprKind::Path(ref path) => typeck.qpath_res(path, callee.hir_id),
+                _ => Res::Err,
+            };
+            let of_adt = matches!(ctor,Res::Def(DefKind::Ctor(CtorOf::Variant,CtorKind::Fn),id) if tcx.parent(tcx.parent(id)) == adt.did());
+            let of_param = matches!(arg.kind,hir::ExprKind::Path(hir::QPath::Resolved(None,path)) if path.res == Res::Local(param.pat.hir_id));
+            of_adt && of_param
+        }
+        _ => false,
+    };
+    Some(if identity { FromBody::Identity } else { FromBody::Rust })
+}
+
+fn foreign_wrapper(tcx: TyCtxt<'_>, id: DefId, target: DefId) -> bool {
+    if !tcx.is_mir_available(id) {
+        return false;
+    }
+    let body = tcx.optimized_mir(id);
+    if body.arg_count != 1 || body.basic_blocks.len() != 1 {
+        return false;
+    }
+    let block = &body.basic_blocks[mir::START_BLOCK];
+    if !matches!(block.terminator().kind, TerminatorKind::Return) {
+        return false;
+    }
+    let mut wrapped = false;
+    for statement in &block.statements {
+        match &statement.kind {
+            StatementKind::StorageLive(_) | StatementKind::StorageDead(_) | StatementKind::Nop => {}
+            StatementKind::Assign(assign) if !wrapped => {
+                let (place, value) = &**assign;
+                let Rvalue::Aggregate(kind, values) = value else {
+                    return false;
+                };
+                if place.local != mir::RETURN_PLACE
+                    || !place.projection.is_empty()
+                    || !matches!(**kind,AggregateKind::Adt(adt,..) if adt == target)
+                    || values.len() != 1
+                {
+                    return false;
+                }
+                let (Operand::Copy(input) | Operand::Move(input)) = values.iter().next().expect("one") else {
+                    return false;
+                };
+                if input.local != mir::Local::from_usize(1) || !input.projection.is_empty() {
+                    return false;
+                }
+                wrapped = true;
+            }
+            _ => return false,
+        }
+    }
+    wrapped
+}
