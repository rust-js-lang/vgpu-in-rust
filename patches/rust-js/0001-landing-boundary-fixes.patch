+import type {Dispatch,ForwardedRef,RefObject,SetStateAction} from "react";
+declare const state: ReturnType<typeof keep>;
+const setter: Dispatch<SetStateAction<number>> = state.setter;
+setter(1);
+state.setter(previous => previous + 1);
+state.dispatch("action");
