new file mode 100644
index 0000000..e00d7b1
--- /dev/null
+++ b/test/corpus/cow_as_ref_borrow.rs
@@ -0,0 +1,63 @@
+// A Cow's AsRef and Borrow dictionaries expose its payload, not its enum tag.
+// Regression for #1481: both borrowed and owned variants in generic code.
+use std::borrow::{Borrow, Cow};
+use std::path::{Path, PathBuf};
+
+fn upper<T: AsRef<str>>(value: T) -> String {
+    value.as_ref().to_uppercase()
+}
+
+fn text<T: Borrow<str>>(value: &T) -> String {
+    value.borrow().to_owned()
+}
+
+fn first<T: AsRef<[i32]>>(value: T) -> i32 {
+    value.as_ref()[0]
+}
+
+fn sum<T: Borrow<[i32]>>(value: &T) -> i32 {
+    value.borrow().iter().sum()
+}
+
+fn matrix<T: AsRef<[f32; 16]>>(value: &T) -> f32 {
+    value.as_ref()[3]
+}
+
+fn path<T: AsRef<Path>>(value: T) -> String {
+    value.as_ref().display().to_string()
+}
+
+fn borrowed_path<T: Borrow<Path>>(value: &T) -> String {
+    value.borrow().display().to_string()
+}
+
+fn borrow_itself<T: Borrow<T>>(value: &T) -> &T {
+    value.borrow()
+}
+
+fn main() {
+    for value in [Cow::Borrowed("bird"), Cow::Owned(String::from("orange"))] {
+        println!("{} {}", upper(value.clone()), text(&value));
+    }
+    let source = [1, 2, 3];
+    let borrowed: Cow<'_, [i32]> = Cow::Borrowed(&source);
+    assert!(std::ptr::eq(borrow_itself(&borrowed), &borrowed));
+    let mut owned: Cow<'_, [i32]> = Cow::Owned(vec![4, 5, 6]);
+    println!(
+        "{} {} {} {}",
+        first(borrowed.clone()),
+        sum(&borrowed),
+        first(owned.clone()),
+        sum(&owned)
+    );
+    owned.to_mut()[0] = 7;
+    println!("{:?} {}", source, sum(&owned));
+    let values = [2.0; 16];
+    let borrowed_matrix: Cow<'_, [f32; 16]> = Cow::Borrowed(&values);
+    let owned_matrix: Cow<'_, [f32; 16]> = Cow::Owned([3.0; 16]);
+    println!("{} {}", matrix(&borrowed_matrix), matrix(&owned_matrix));
+    assert!(std::ptr::eq(borrowed_matrix.as_ref(), &values));
+    for value in [Cow::Borrowed(Path::new("a/b")), Cow::Owned(PathBuf::from("c/d"))] {
+        println!("{} {}", path(value.clone()), borrowed_path(&value));
+    }
+}
