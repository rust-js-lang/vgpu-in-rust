diff --git a/test/check-fast-pool.test.ts b/test/check-fast-pool.test.ts
new file mode 100644
index 0000000..97fb349
--- /dev/null
+++ b/test/check-fast-pool.test.ts
@@ -0,0 +1,43 @@
+import {expect,test} from "bun:test";
+import {mkdtempSync,rmSync} from "node:fs";
+import {tmpdir} from "node:os";
+import {join,resolve} from "node:path";
+import {run,type Job} from "../scripts/checkFast";
+
+for(const resource of ["cores","memory"] as const) {
+  test(`the pool starts a fitting job behind one waiting for ${resource}`,async()=>{
+    const directory=mkdtempSync(join(tmpdir(),"pool-backfill-"));
+    const marker=join(directory,"small-started");
+    // Fresh names prevent the machine's timing history from replacing the
+    // explicit resource weights in this scheduling regression.
+    const key=`backfill-${crypto.randomUUID()}`;
+    const job=(name:string,code:string,weight:number,memory=0):Job=>({
+      name:`${key}-${name}`,cmd:[process.execPath,"-e",code],env:{},timeout:5,weight,memory,
+    });
+    const jobs=[
+      job("first",`const until=Date.now()+2000;while(!(await Bun.file(${JSON.stringify(marker)}).exists())&&Date.now()<until)await Bun.sleep(10);process.exit(await Bun.file(${JSON.stringify(marker)}).exists()?0:1);`,1),
+      job("large","",resource==="cores"?2:1,resource==="memory"?1e9:0),
+      job("small",`await Bun.write(${JSON.stringify(marker)},"started");`,1),
+    ];
+    try {
+      const results=await run(jobs,"unused",2,{began:Date.now(),samples:[]});
+      expect(results.map(result=>result.code)).toEqual([0,0,0]);
+      expect(results.map(result=>result.job.name)).toEqual([jobs[0].name,jobs[2].name,jobs[1].name]);
+      expect(results[2].start).toBeGreaterThanOrEqual(Math.max(results[0].end,results[1].end));
+    } finally {
+      rmSync(directory,{recursive:true,force:true});
+    }
+  },15_000);
+}
+
+
+test("fractional reservations drain exactly before an oversized job runs alone",()=>{
+  const source=`import {run} from ${JSON.stringify(resolve(import.meta.dir,"../scripts/checkFast.ts"))};
+const key=crypto.randomUUID();
+const jobs=[0.1,0.2,1].map((weight,index)=>({name:key+index,cmd:[process.execPath,"-e",""],env:{},timeout:5,weight,memory:index===2?1e9:0}));
+const results=await run(jobs,"unused",2,{began:Date.now(),samples:[]});
+if(results.length!==3||results.some(result=>result.code!==0))process.exit(1);
+`;
+  const child=Bun.spawnSync([process.execPath,"-e",source],{timeout:3000,stdout:"pipe",stderr:"pipe"});
+  expect(child.exitCode,child.stdout.toString()+child.stderr.toString()).toBe(0);
+},10_000);
